---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { getLocale, getRoutePath } from "@/lib/i18n";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { ClientRouter } from "astro:transitions";
import { baseLocale, localeDefinitions, type Locale } from "../../i18n.config";
import "@/app.css";

interface Props {
  title?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  description?: string;
  /** Locale-neutral fallback for pages without translations. Omits hreflang alternates. */
  translationFallback?: string;
}

const en = {
  metaDescription: "Aaron212's portfolio, projects, and blog.",
};

const messages = {
  en,
  "zh-cn": {
    metaDescription: "Aaron212的个人作品集、项目与博客。",
  },
} satisfies Record<Locale, typeof en>;

const lang = getLocale(Astro.currentLocale);
const t = messages[lang];
const { type = "website", publishedTime, title, description = t.metaDescription, translationFallback } = Astro.props;
const pageTitle = title ? `${title} | Aaron212` : "Aaron212";
const ogLocale = localeDefinitions.find(({ locale }) => locale === lang)!.hreflang.replace("-", "_");
const routePath = getRoutePath(Astro.url.pathname);
const canonicalUrl = getAbsoluteLocaleUrl(lang, routePath);
const alternateUrls = localeDefinitions.map(({ locale, hreflang }) => ({
  hreflang,
  href: getAbsoluteLocaleUrl(locale, routePath),
}));
const defaultLocaleUrl = getAbsoluteLocaleUrl(baseLocale, routePath);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {!translationFallback && (
      <>
        {alternateUrls.map(({ hreflang, href }) => (
          <link rel="alternate" hreflang={hreflang} href={href} />
        ))}
        <link rel="alternate" hreflang="x-default" href={defaultLocaleUrl} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="Aaron212" href="/rss.xml" />
    <meta property="og:site_name" content="Aaron212" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@AR___212" />
    <title>{pageTitle}</title>
    <slot name="head" />
    <ClientRouter />
  </head>
  <body class="flex min-h-dvh flex-col bg-canvas text-foreground">
    <Header />
    <main id="content" tabindex="-1" class="mt-4 flex-1 scroll-mt-16 select-none">
      <slot />
    </main>
    <Footer {translationFallback} />
  </body>
</html>
