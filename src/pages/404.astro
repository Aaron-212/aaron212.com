---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found">
  <div class="flex min-h-[75dvh] flex-col items-center justify-center gap-3 px-6 text-center">
    <h1 class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1 text-4xl tracking-tight lg:text-6xl">
      <span class="font-semibold">404</span>
      <span class="font-light">Not Found</span>
    </h1>
    <span class="text-secondary">Check the URL?</span>
  </div>
</BaseLayout>
