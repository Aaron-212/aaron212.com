---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="博客">
  <div class="mx-auto max-w-4xl px-6 py-12 lg:py-20">
    <h1 class="mb-10 text-center text-4xl font-semibold lg:text-5xl">博客</h1>

    <ul class="space-y-6">
      {posts.map((post) => (
        <li>
          <a
            lang={post.data.lang}
            class="hover:text-accent focus-visible:text-accent text-xl font-semibold transition-colors"
            href={`/zh-cn/blog/${post.id}/`}
          >
            {post.data.title}
          </a>
          <p class="text-subtle mt-1 text-sm">{post.data.date.toLocaleDateString("zh-cn")}</p>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
