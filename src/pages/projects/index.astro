---
import ShowcaseItem from "@/components/ShowcaseItem.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Projects">
  <div class="mx-auto max-w-6xl px-6 py-12 lg:py-20">
    <h1 class="mb-10 text-center text-4xl font-semibold tracking-tight lg:text-5xl">Projects</h1>

    <div class="flex flex-col md:gap-4">
      <ShowcaseItem
        type="iOS/iPadOS/macOS App"
        title="McSrvrS"
        description="A native Minecraft: Java Edition server monitor for iPhone, iPad, and Mac."
        icon={{
          lightSrc: "https://images-bucket.aaron212.com/portfolio/mcsrvrs/McSrvrS-iOS-Default-1024%401x.png",
          darkSrc: "https://images-bucket.aaron212.com/portfolio/mcsrvrs/McSrvrS-iOS-Dark-1024%401x.png",
          alt: "McSrvrS app icon",
        }}
        tag={{ name: "Alpha", tone: "teal" }}
        actions={[
          { label: "Learn More", href: "/projects/mcsrvrs/" },
          { label: "GitHub", href: "https://github.com/Aaron-212/McSrvrS" },
        ]}
      />

      <ShowcaseItem
        type="macOS App"
        title="FnPilot"
        description="Change fn key settings based on the frontmost window."
        icon={{
          lightSrc: "https://images-bucket.aaron212.com/portfolio/fnpilot/FnPilot-macOS-Default-1024%401x.png",
          darkSrc: "https://images-bucket.aaron212.com/portfolio/fnpilot/FnPilot-macOS-Dark-1024%401x.png",
          alt: "FnPilot app icon",
        }}
        tag={{ name: "Beta", tone: "teal" }}
        actions={[
          { label: "Learn More", href: "/projects/fnpilot/" },
          { label: "GitHub", href: "https://github.com/Aaron-212/FnPilot" },
        ]}
      />

      <ShowcaseItem
        type="macOS App"
        title="NBTPlus"
        description="A simple NBT editor for macOS."
        icon={{
          lightSrc: "https://images-bucket.aaron212.com/portfolio/nbtplus/NBTPlus-macOS-Default-1024%401x.png",
          darkSrc: "https://images-bucket.aaron212.com/portfolio/nbtplus/NBTPlus-macOS-Dark-1024%401x.png",
          alt: "NBTPlus app icon",
        }}
        tag={{ name: "Dev", tone: "purple" }}
        actions={[
          { label: "Learn More", href: "/projects/nbtplus/" },
          { label: "GitHub", href: "https://github.com/Aaron-212/NBTPlus" },
        ]}
      />

      <ShowcaseItem
        type="CLI Prompt Engine"
        title="chips"
        description="An experimental prompt engine written in Zig for Nushell and Zsh."
        actions={[{ label: "GitHub", href: "https://github.com/Aaron-212/chips" }]}
      />

      <ShowcaseItem
        type="Web app"
        title="CF Senders"
        description="A SvelteKit email-sending interface on Cloudflare Workers, protected by Cloudflare Access."
        actions={[{ label: "GitHub", href: "https://github.com/Aaron-212/cf-senders" }]}
      />

      <ShowcaseItem
        type="npm package"
        title="@aaron212/astro-highlights"
        monospaceTitle
        description="Highlight code with @pierre/highlights in Astro and Sätteri, with server-side rendering and system light and dark themes."
        actions={[
          { label: "NPM", href: "https://www.npmjs.com/package/@aaron212/astro-highlights" },
          { label: "GitHub", href: "https://github.com/Aaron-212/astro-highlights" },
        ]}
      />

      <ShowcaseItem
        type="npm package"
        title="@aaron212/astro-pele"
        monospaceTitle
        description="Render Mermaid diagrams with Pele in Astro and Sätteri."
        actions={[
          { label: "NPM", href: "https://www.npmjs.com/package/@aaron212/astro-pele" },
          { label: "GitHub", href: "https://github.com/Aaron-212/astro-pele" },
        ]}
      />

      <ShowcaseItem
        type="npm package"
        title="@aaron212/astro-typlet"
        monospaceTitle
        description="Render Typst formulas with Typlet in Astro and Sätteri."
        actions={[
          { label: "NPM", href: "https://www.npmjs.com/package/@aaron212/astro-typlet" },
          { label: "GitHub", href: "https://github.com/Aaron-212/astro-typlet" },
        ]}
      />
      <ShowcaseItem
        type="Zed Extension"
        title="Carbon for Zed"
        description="Carbon syntax highlighting, navigation, and editing support for Zed, backed by a Tree-sitter grammar synced from the Carbon Language project."
        actions={[
          { label: "GitHub (Plugin)", href: "https://github.com/Aaron-212/zed-carbon" },
          { label: "GitHub (Tree-sitter Grammar)", href: "https://github.com/Aaron-212/tree-sitter-carbon" },
        ]}
      />
    </div>
  </div>
</BaseLayout>
