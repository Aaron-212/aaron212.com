---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getDocPath } from "@/lib/docs";
---

<BaseLayout title="Docs">
  <div class="mx-auto max-w-4xl px-6 py-12 lg:py-20">
    <h1 class="mb-10 text-center text-4xl font-semibold tracking-tight lg:text-5xl">Documentations</h1>
    <ul class="list-disc space-y-4 ps-6 text-xl">
      <li>
        <a class="text-accent hover:underline" href={getDocPath()}>
          Cheat sheets
        </a>
      </li>
    </ul>
  </div>
</BaseLayout>
