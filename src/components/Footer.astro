---
import { getLocale, getRoutePath } from "@/lib/i18n";
import type { Locale } from "../../i18n.config";
import { getRelativeLocaleUrl } from "astro:i18n";
import { Icon } from "astro-icon/components";

const en = {
  ariaSwitchLanguage: "Switch language",
  footerSourceLicense: "Source code is licensed under the MIT License.",
  footerLicensePrefix: "Website content is licensed under ",
  footerLicenseName: "CC BY SA 4.0",
  footerLicenseSuffix: ", unless otherwise noted.",
};

const messages = {
  en,
  "zh-cn": {
    ariaSwitchLanguage: "切换语言",
    footerSourceLicense: "源代码采用 MIT 许可证授权。",
    footerLicensePrefix: "除非另有说明，网站内容采用",
    footerLicenseName: "CC BY SA 4.0",
    footerLicenseSuffix: "许可协议授权。",
  },
} satisfies Record<Locale, typeof en>;

const year = new Date().getFullYear();
const currentLocale = getLocale(Astro.currentLocale);
const t = messages[currentLocale];
const routePath = getRoutePath(Astro.url.pathname);
const localeOptions = [
  { locale: "en", label: "English" },
  { locale: "zh-cn", label: "简体中文" },
] as const;
const currentLocaleLabel = localeOptions.find(({ locale }) => locale === currentLocale)?.label ?? currentLocale;
---

<footer class="mt-16 flex min-h-32 flex-col items-center justify-center bg-slate-100 text-center text-slate-600 select-none dark:bg-slate-900 dark:text-slate-300">
  <div class="flex w-full max-w-4xl flex-row items-center justify-between gap-4 px-6">
    <div class="flex flex-col items-start gap-1">
      <p>© 2021-{year} Aaron212</p>
      <p class="text-sm">{t.footerSourceLicense}</p>
      <p class="text-sm">
        {t.footerLicensePrefix}
        <a href="https://creativecommons.org/licenses/by-sa/4.0/" class="hover:underline">
          {t.footerLicenseName}
        </a>
        {t.footerLicenseSuffix}
      </p>
    </div>

    <details class="group relative">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 rounded-lg px-3 py-2 transition-colors hover:bg-slate-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 dark:hover:bg-slate-800 dark:focus-visible:outline-blue-400"
        aria-label={t.ariaSwitchLanguage}
      >
        <span>{currentLocaleLabel}</span>
        <Icon name="fa7-solid:chevron-down" class="size-3 transition-transform group-open:rotate-180" />
      </summary>

      <ul class="absolute right-0 bottom-full mb-2 min-w-36 overflow-hidden rounded-xl border border-slate-200 bg-white p-1 text-left shadow-lg dark:border-slate-700 dark:bg-slate-950">
        {localeOptions.map(({ locale, label }) => (
          <li>
            <a
              href={`${getRelativeLocaleUrl(locale, routePath)}${Astro.url.search}`}
              lang={locale}
              aria-current={locale === currentLocale ? "page" : undefined}
              class="block rounded-lg px-3 py-2 transition-colors hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-blue-600 dark:hover:bg-slate-800 dark:focus-visible:outline-blue-400"
              class:list={[
                {
                  "font-medium text-black dark:text-white": locale === currentLocale,
                },
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </details>
  </div>
</footer>
