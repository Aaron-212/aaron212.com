---
import AppIcon from "@/components/AppIcon.astro";
import ArrowButton from "@/components/ArrowButton.astro";
import BranchTag from "@/components/BranchTag.astro";

interface Action {
  label: string;
  href: string;
}

interface Icon {
  lightSrc: string;
  darkSrc: string;
  alt: string;
}

interface Tag {
  name: string;
  tone:
    | "slate"
    | "gray"
    | "zinc"
    | "neutral"
    | "stone"
    | "red"
    | "orange"
    | "amber"
    | "yellow"
    | "lime"
    | "green"
    | "emerald"
    | "teal"
    | "cyan"
    | "sky"
    | "blue"
    | "indigo"
    | "violet"
    | "purple"
    | "fuchsia"
    | "pink"
    | "rose";
}

interface Props {
  type?: string;
  title: string;
  monospaceTitle?: boolean;
  description?: string;
  actions: Action[];
  icon?: Icon;
  tag?: Tag;
}

const { type, title, monospaceTitle, description, actions, icon, tag } = Astro.props;
---

<article class="flex flex-col gap-8 p-4 md:gap-12">
  <div class="flex flex-row gap-4 md:gap-12">
    <div class="flex flex-1 flex-col gap-2 md:gap-4">
      <div class="flex flex-col gap-0.5">
        <div class="flex flex-row items-center gap-4">
          <h2
            class:list={[
              "font-medium",
              monospaceTitle
                ? "text-xl md:text-3xl font-mono select-text bg-surface py-1 px-2 rounded-lg"
                : "text-2xl md:text-4xl",
            ]}
          >
            {title}
          </h2>
          {tag && <BranchTag name={tag.name} tone={tag.tone} />}
        </div>

        {type && <p class="text-sm text-secondary">{type}</p>}
      </div>

      {description && <p class="text-md text-muted md:text-lg">{description}</p>}

      <div class="flex flex-col flex-wrap items-start">
        {actions.map((action) => (
          <ArrowButton label={action.label} href={action.href} />
        ))}
      </div>
      <hr class="border-0.5 border-slate-500/50 mt-4" />
    </div>

    {icon ? (
      <AppIcon
        lightSrc={icon.lightSrc}
        darkSrc={icon.darkSrc}
        alt={icon.alt}
        class="size-16 md:size-24 lg:size-32"
        sizes="8rem"
      />
    ) : (
      <div class="w-16 shrink-0 md:w-24 lg:w-32" aria-hidden="true" />
    )}
  </div>
</article>
