---
import { getLocale } from "@/lib/i18n";
import { messages } from "./messages";
import type { MarkdownHeading } from "astro";

interface Props {
  headings: MarkdownHeading[];
  lang: string;
}

const { headings, lang } = Astro.props;
const t = messages[getLocale(Astro.currentLocale)];
---

<details class="not-prose rounded-lg border border-border p-5 lg:hidden">
  <summary class="cursor-pointer text-sm font-semibold uppercase tracking-wide">{t.tocOnThisPage}</summary>
  <nav aria-label={t.tocAriaLabel} class="mt-3">
    <ol lang={lang} class="space-y-2 border-l-2 border-foreground/20 text-sm">
      {headings.map(({ depth, slug, text }) => (
        <li class={`text-foreground/60 hover:text-foreground transition-colors ${depth === 3 ? "ps-8" : "ps-4"}`}>
          <a class="block text-inherit" href={`#${slug}`}>
            {text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</details>
