---
interface Props {
  label: string;
  href: string;
}

const { label, href } = Astro.props;
import { Icon } from "astro-icon/components";
---

<div class="flex flex-row items-center">
  <a href={href} class="text-accent text-base hover:underline md:text-lg">
    {label}
  </a>
  <Icon name="fa7-solid:chevron-right" class="text-accent size-4" />
</div>
