---
import { getDocPath } from "@/lib/docs";
import { getLocale } from "@/lib/i18n";
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import type { Locale } from "../../i18n.config";

type Link = {
  label: string;
  href: string;
  lang?: string;
};

type Sublink = Link & {
  showOnMobile?: boolean;
};

type LinkGroup = Link & {
  links: Sublink[];
};

const en = {
  skipToContent: "Skip to content",
  navHome: "Home",
  navAbout: "About",
  navProjects: "Projects",
  navBlog: "Blog",
  navDocs: "Docs",
  navCheatsheets: "Cheat sheets",
  navOtherLinks: "Other Links",
  navPartnerLinks: "Partner Links",
  ariaSectionMenu: (section: string) => `${section} menu`,
  ariaMainNavigation: "Main navigation",
  ariaXProfile: "Aaron212 on X",
  ariaGithubProfile: "Aaron212 on GitHub",
  ariaToggleNavigation: "Toggle navigation menu",
};

const messages = {
  en,
  "zh-cn": {
    skipToContent: "跳到正文",
    navHome: "首页",
    navAbout: "关于",
    navProjects: "项目",
    navBlog: "博客",
    navDocs: "文档",
    navCheatsheets: "速查表",
    navOtherLinks: "其他链接",
    navPartnerLinks: "友情链接",
    ariaSectionMenu: (section: string) => `${section}菜单`,
    ariaMainNavigation: "主导航",
    ariaXProfile: "Aaron212的X主页",
    ariaGithubProfile: "Aaron212的GitHub主页",
    ariaToggleNavigation: "切换导航菜单",
  },
} satisfies Record<Locale, typeof en>;

const locale = getLocale(Astro.currentLocale);
const t = messages[locale];

function normalizePath(path: string): string {
  return path.length > 1 ? path.replace(/\/+$/, "") : path;
}

const currentPath = normalizePath(Astro.url.pathname);
const isCurrentPage = (href: string): boolean => href.startsWith("/") && normalizePath(href) === currentPath;

const latestPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const homeHref = getRelativeLocaleUrl(locale, "/");

const links: LinkGroup[] = [
  {
    label: t.navHome,
    href: homeHref,
    links: [{ label: t.navAbout, href: getRelativeLocaleUrl(locale, "/about"), showOnMobile: true }],
  },
  {
    label: t.navProjects,
    href: getRelativeLocaleUrl(locale, "/projects"),
    links: [
      { label: "McSrvrS", href: getRelativeLocaleUrl(locale, "/projects/mcsrvrs") },
      { label: "FnPilot", href: getRelativeLocaleUrl(locale, "/projects/fnpilot") },
      { label: "NBTPlus", href: getRelativeLocaleUrl(locale, "/projects/nbtplus") },
    ],
  },
  {
    label: t.navBlog,
    href: getRelativeLocaleUrl(locale, "/blog"),
    links: latestPosts.map((post) => ({
      label: post.data.title,
      href: getRelativeLocaleUrl(locale, `/blog/${post.id}`),
      lang: post.data.lang,
    })),
  },
  {
    label: t.navDocs,
    href: getRelativeLocaleUrl(locale, "/docs"),
    links: [{ label: t.navCheatsheets, href: getDocPath() }],
  },
];

const rightLinks = {
  label: t.navOtherLinks,
  links: [
    {
      label: t.navPartnerLinks,
      href: getRelativeLocaleUrl(locale, "/partner-links"),
      showOnMobile: true,
    },
  ] satisfies Sublink[],
};

const mobileLinks: Link[] = [
  ...links.flatMap(({ label, href, lang, links }) => [
    { label, href, lang },
    ...links.filter(({ showOnMobile }) => showOnMobile),
  ]),
  ...rightLinks.links.filter(({ showOnMobile }) => showOnMobile),
];
---

<header data-site-header class="pointer-events-none sticky top-0 z-50 h-12 select-none">
  <a
    href="#content"
    class="bg-surface text-foreground focus-visible:outline-accent pointer-events-auto sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus-visible:outline-2"
  >
    {t.skipToContent}
  </a>

  <nav
    data-navigation
    aria-label={t.ariaMainNavigation}
    class="bg-surface/80 pointer-events-auto relative flex h-12 w-full flex-col items-center overflow-clip backdrop-blur-xl transition-[height] duration-250 ease-in-out motion-reduce:transition-none"
  >
    <div class="mx-auto flex h-12 w-full max-w-4xl shrink-0 items-center gap-4 px-6">
      <a
        href={homeHref}
        class="text-foreground hover:text-accent focus-visible:text-accent focus-visible:outline-accent rounded text-lg font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        Aaron212
      </a>

      <div data-desktop-sections class="hidden h-12 items-center ps-2 lg:flex">
        {links.map((link, index) => (
          <div data-section-group class="group flex items-center px-1">
            <a
              class="text-foreground group-hover:text-accent group-has-focus-visible:text-accent transition-colors"
              href={link.href}
              aria-current={isCurrentPage(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
            <button
              type="button"
              data-section-trigger
              aria-label={t.ariaSectionMenu(link.label)}
              aria-expanded="false"
              aria-controls={`site-submenu-${index}`}
              class="group-hover:text-accent group-has-focus-visible:text-accent focus-visible:outline-accent flex h-8 shrink-0 cursor-pointer items-center justify-center rounded opacity-0 transition group-focus-within:opacity-100 group-hover:opacity-100 focus-visible:outline-2 focus-visible:-outline-offset-2 aria-expanded:opacity-100 motion-reduce:transition-none"
            >
              <Icon name="fa7-solid:caret-down" class="size-4" />
            </button>
            <div
              id={`site-submenu-${index}`}
              hidden
              data-section-panel
              class="absolute top-10 left-1/2 z-10 flex w-full max-w-4xl -translate-x-1/2 flex-col gap-2 px-6 pt-10"
            >
              <p class="text-muted text-sm">{link.label}</p>
              {link.links.map((sublink) => (
                <a
                  class="text-foreground hover:text-accent focus-visible:text-accent w-fit text-2xl font-bold transition-colors duration-200 ease-in-out"
                  href={sublink.href}
                  lang={sublink.lang}
                  aria-current={isCurrentPage(sublink.href) ? "page" : undefined}
                >
                  {sublink.label}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="grow"><!-- Spacer --></div>

      <div class="flex items-center">
        <div data-section-group data-desktop-other class="hidden h-12 items-center lg:flex">
          <button
            type="button"
            data-section-trigger
            aria-label={t.navOtherLinks}
            aria-expanded="false"
            aria-controls="site-submenu-other"
            class="hover:text-accent focus-visible:text-accent focus-visible:outline-accent flex min-h-11 min-w-11 shrink-0 cursor-pointer items-center justify-center rounded transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2 motion-reduce:transition-none"
          >
            <Icon name="fa7-solid:ellipsis" class="size-5" />
          </button>
          <div
            id="site-submenu-other"
            hidden
            data-section-panel
            class="absolute top-10 left-1/2 z-10 flex w-full max-w-4xl -translate-x-1/2 flex-col items-end gap-2 px-6 pt-10"
          >
            <p class="text-muted text-sm">{rightLinks.label}</p>
            {rightLinks.links.map((link) => (
              <a
                class="text-foreground hover:text-accent focus-visible:text-accent text-2xl font-bold transition-colors"
                href={link.href}
                aria-current={isCurrentPage(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
        <a
          href="https://x.com/AR___212"
          aria-label={t.ariaXProfile}
          class="hover:text-accent focus-visible:text-accent focus-visible:outline-accent flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2"
        >
          <Icon name="fa7-brands:x-twitter" class="size-5" />
        </a>
        <a
          href="https://github.com/Aaron-212"
          aria-label={t.ariaGithubProfile}
          class="hover:text-accent focus-visible:text-accent focus-visible:outline-accent flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2"
        >
          <Icon name="fa7-brands:github" class="size-5" />
        </a>

        <details data-mobile-menu class="lg:hidden">
          <summary
            class="hover:text-accent focus-visible:text-accent focus-visible:outline-accent flex min-h-11 min-w-11 shrink-0 cursor-pointer list-none items-center justify-center rounded transition-colors focus-visible:outline-2 focus-visible:-outline-offset-2"
            aria-label={t.ariaToggleNavigation}
          >
            <Icon name="fa7-solid:bars" class="size-5" />
          </summary>
          <div class="absolute top-12 left-1/2 flex w-full max-w-4xl -translate-x-1/2 flex-col gap-2 px-6 pt-8">
            {mobileLinks.map((link) => (
              <a
                class="text-foreground hover:text-accent focus-visible:text-accent text-2xl font-bold transition-colors duration-200 ease-in-out"
                href={link.href}
                lang={link.lang}
                aria-current={isCurrentPage(link.href) ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>
        </details>
      </div>
    </div>
  </nav>
</header>

<script>
  let cleanupNavigation: (() => void) | undefined;

  function setupNavigation() {
    cleanupNavigation?.();

    const nav = document.querySelector<HTMLElement>("[data-navigation]");
    if (!nav) return;
    const navigation = nav;

    const controller = new AbortController();
    const { signal } = controller;
    const desktop = window.matchMedia("(min-width: 64rem) and (not (pointer: coarse))");
    const hover = window.matchMedia("(hover: hover) and (pointer: fine)");
    const groups = Array.from(navigation.querySelectorAll<HTMLElement>("[data-section-group]"));
    const mobileMenu = navigation.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
    let active: { button: HTMLButtonElement; panel: HTMLElement } | undefined;
    let hoverTimer: ReturnType<typeof setTimeout> | undefined;

    function cancelHover() {
      clearTimeout(hoverTimer);
      hoverTimer = undefined;
    }

    function closeMobileMenu(restoreFocus = false) {
      if (!mobileMenu?.open) return;
      mobileMenu.open = false;
      if (restoreFocus) mobileMenu.querySelector<HTMLElement>("summary")?.focus();
    }

    function closeMenu(restoreFocus = false) {
      cancelHover();
      if (!active) return;
      const { button, panel } = active;
      active = undefined;
      if (restoreFocus) button.focus();
      panel.hidden = true;
      button.setAttribute("aria-expanded", "false");
      navigation.removeAttribute("data-expanded");
    }

    function openMenu(button: HTMLButtonElement, panel: HTMLElement) {
      cancelHover();
      if (!desktop.matches || active?.button === button) return;
      // A pointer must not hide a different submenu while keyboard focus is inside it.
      if (active?.panel.contains(document.activeElement)) return;
      closeMenu();
      active = { button, panel };
      panel.hidden = false;
      button.setAttribute("aria-expanded", "true");
      navigation.setAttribute("data-expanded", "");
    }

    for (const group of groups) {
      const button = group.querySelector<HTMLButtonElement>("[data-section-trigger]");
      const panel = group.querySelector<HTMLElement>("[data-section-panel]");
      if (!button || !panel) continue;

      button.addEventListener(
        "click",
        () => {
          if (active?.button === button) closeMenu();
          else openMenu(button, panel);
        },
        { signal },
      );

      group.addEventListener(
        "pointerenter",
        (event) => {
          cancelHover();
          if (!desktop.matches || !hover.matches || event.pointerType !== "mouse") return;
          if (active) openMenu(button, panel);
          else hoverTimer = setTimeout(() => openMenu(button, panel), 250);
        },
        { signal },
      );

      group.addEventListener("pointerleave", cancelHover, { signal });
    }

    navigation.addEventListener(
      "pointerleave",
      () => {
        cancelHover();
        if (active?.button !== document.activeElement && !active?.panel.contains(document.activeElement)) closeMenu();
      },
      { signal },
    );

    document.addEventListener(
      "focusin",
      (event) => {
        cancelHover();
        if (active && event.target !== active.button && !active.panel.contains(event.target as Node)) closeMenu();
      },
      { signal },
    );

    document.addEventListener(
      "pointerdown",
      (event) => {
        if (!navigation.contains(event.target as Node)) {
          closeMenu();
          closeMobileMenu();
        }
      },
      { signal },
    );

    document.addEventListener(
      "keydown",
      (event) => {
        if (event.key !== "Escape") return;
        cancelHover();
        if (active) {
          const restoreFocus =
            active.button === document.activeElement || active.panel.contains(document.activeElement);
          closeMenu(restoreFocus);
          event.preventDefault();
        } else if (mobileMenu?.open) {
          closeMobileMenu(mobileMenu.contains(document.activeElement));
          event.preventDefault();
        }
      },
      { signal },
    );

    desktop.addEventListener(
      "change",
      () => {
        closeMenu(active?.panel.contains(document.activeElement));
        closeMobileMenu();
      },
      { signal },
    );
    hover.addEventListener("change", cancelHover, { signal });

    cleanupNavigation = () => {
      closeMenu();
      closeMobileMenu();
      controller.abort();
      cleanupNavigation = undefined;
    };
  }

  document.addEventListener("astro:page-load", setupNavigation);
  document.addEventListener("astro:before-swap", () => cleanupNavigation?.());
</script>

<style>
  [data-site-header]::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    visibility: hidden;
    opacity: 0;
    background-color: color-mix(in oklab, var(--color-surface) 25%, transparent);
    backdrop-filter: blur(24px);
    transition:
      opacity 250ms ease-in-out,
      visibility 250ms ease-in-out;
    content: "";
  }

  [data-section-panel][hidden] {
    display: none;
  }

  [data-mobile-menu] summary::-webkit-details-marker {
    display: none;
  }

  @media (width < 64rem), (pointer: coarse) {
    [data-navigation]:has([data-mobile-menu][open]) {
      height: 75dvh;
      overflow-y: auto;
      backdrop-filter: none;
    }
  }

  @media (width >= 64rem) {
    [data-navigation][data-expanded] {
      height: 20rem;
      backdrop-filter: none;
    }
  }

  [data-site-header]:has([data-navigation][data-expanded], [data-mobile-menu][open])::before {
    pointer-events: auto;
    visibility: visible;
    opacity: 1;
  }

  @media (pointer: coarse) {
    [data-desktop-sections],
    [data-desktop-other] {
      display: none;
    }

    [data-mobile-menu] {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-site-header]::before {
      transition: none;
    }
  }
</style>
